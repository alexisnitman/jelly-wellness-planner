# Every key this app needs. Copy this file to .env and fill it in.
# The app looks for .env in this folder first, then in the folder above it (so a shared .env one level up also works).
PORTKEY_API_KEY=
# Optional: set to false to switch every AI feature off.
AI_ENABLED=true
# The first start of a fresh install creates a throwaway demo account (see the README). Set to false before real use.
DEMO_ACCOUNT=true
